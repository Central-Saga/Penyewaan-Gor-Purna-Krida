APP_NAME="GOR Purnakrida"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=gor_purnakrida
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Dev default = log (email ditulis ke laravel.log). Produksi: set MAIL_MAILER=smtp + kredensial di bawah.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@gorpurnakrida.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Livewire: disk penyimpanan sementara file upload (kosong = default "local").
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=

WWWGROUP=1000
WWWUSER=1000

# Port & konfigurasi Docker Compose (compose.yaml).
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=3306
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# Seed admin awal (AdminSeeder)
ADMIN_EMAIL=admin@gorpurnakrida.test
ADMIN_PASSWORD=password
PENGELOLA_EMAIL=pengelola@gorpurnakrida.test
PENGELOLA_PASSWORD=password